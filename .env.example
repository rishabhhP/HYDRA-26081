HYDRA_MODE=demo
# HYDRA_MODEL_REPO=/absolute/path/to/nwpblend
# HYDRA_HISTORY=/absolute/path/to/daily_history.parquet
# HYDRA_NLP_API_URL=https://your-model-service.example/v1/hydra-answer
# HYDRA_NLP_API_KEY=server-side-secret
# HYDRA_NLP_TIMEOUT_SECONDS=20
# Standalone deterministic WeatherGPT query parser. See weather_query_parser/README.md.
# HYDRA_QUERY_PARSER_URL=http://127.0.0.1:8010/parse
# HYDRA_QUERY_PARSER_API_KEY=server-side-secret
# HYDRA_QUERY_PARSER_TIMEOUT_SECONDS=4
# IndianAPI Weather API: https://indianapi.in/weather-api
# Kept server-side. Live station reports are cached to preserve API quota.
# INDIAN_WEATHER_API_KEY=your-indianapi-key
# INDIAN_WEATHER_CACHE_MINUTES=30
# Retained daily samples are written to runtime/live_weather_daily.csv.
# Run `python -m backend.live_collector --interval-minutes 30` to collect them continuously.
